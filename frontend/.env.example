# Copy to frontend/.env.local for local development. Restart `npm run dev` after any change:
# NEXT_PUBLIC_* values are built into the browser bundle, so they must never contain secrets.
# Never put the worker's X-Worker-Key (WORKER_API_KEYS) here.

# FastAPI backend, no trailing slash
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Firebase web app settings. For the local emulator any non-empty API key works and the
# project must match the backend's FIREBASE_PROJECT_ID.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-nigahsense.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-nigahsense

# Local only: Firebase Auth emulator host:port. Leave empty for a real Firebase project.
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
